# Official Microsoft .NET 11 SDK, built from upstream binaries by nixpkgs' own
# binary SDK builder.
#
# Why this exists: nixpkgs (including nixpkgs-unstable) still builds 11.0 from
# the VMR source tarball pinned to 11.0.0-rc.3, and the 11.0 channel has no
# `sdk_11_0-bin` attribute at all -- only channels that carry a `releases.nix`
# (9.0, 10.0) get `-bin` attributes. So the GA release metadata is kept in
# ./releases.nix (generated by `just update-overlay dotnet-sdk-11`) and fed to
# `dotnetCorePackages.buildDotnetSdk` from the unstable package set, which is
# the only one that knows about the 11.0 channel.
#
# Delete this overlay and switch back to `dotnetCorePackages.sdk_11_0-bin` once
# nixpkgs ships the GA release.
{
  unstable,
}:
let
  versions = builtins.fromJSON (builtins.readFile ./versions.json);
  sdk = (unstable.dotnetCorePackages.buildDotnetSdk ./releases.nix).sdk_11_0;
in
  if sdk.version == versions.version
  then sdk
  else throw ''
    overlays/dotnet-sdk-11 is inconsistent: releases.nix builds ${sdk.version}
    while versions.json says ${versions.version}.
    Run `just update-overlay dotnet-sdk-11` to regenerate it.''
